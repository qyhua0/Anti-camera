<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>img\privacy_secure_anonymous_hide_icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>x-保护</Product>
    <Copyright>Copyright © 2026</Copyright>
    <!-- 作者署名：写进程序集元数据，exe 右键「属性 → 详细信息」里能看到 -->
    <Authors>zhenhua</Authors>
    <Company>zhenhua</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- 界面检查/截图工具在另一个程序集里，需要直接碰到 internal 的主题控件（见 D:\tools\verify） -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ui_snap</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>gamma_probe</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>acsec_test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Remove="third_party\Autoruns64.exe" />
    <None Remove="third_party\procexp64.exe" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="img\privacy_secure_anonymous_hide_icon.ico" />
    <Content Include="third_party\Autoruns64.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="third_party\procexp64.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PacketDotNet" Version="1.4.8" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
    <PackageReference Include="System.Management" Version="9.0.5" />
  </ItemGroup>

</Project>